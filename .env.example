# ==============================================================================
# MODELO DE VARIÁVEIS DE AMBIENTE — PROJETO CLAI
# Copie este arquivo para .env.dev (desenvolvimento) ou .env.prod (produção).
# NUNCA versione arquivos .env reais contendo credenciais ou senhas!
# ==============================================================================

# Perfil Ativo do Spring Boot (dev | prod)
SPRING_PROFILES_ACTIVE=dev

# Configurações do Banco de Dados PostgreSQL (Container db no Docker Compose)
POSTGRES_DB=claidb
POSTGRES_USER=claiapp
POSTGRES_PASSWORD=clai123

# Configuração Spring Boot Datasource
# No Docker Compose (rede interna): jdbc:postgresql://db:5432/claidb
# No host local (executando fora do Docker): jdbc:postgresql://localhost:5432/claidb
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/claidb
SPRING_DATASOURCE_USERNAME=claiapp
SPRING_DATASOURCE_PASSWORD=clai123

# Segurança e Autenticação (JWT)
JWT_SECRET=super_secret_jwt_key_example_minimum_256_bits_length_here
JWT_EXPIRATION_MINUTES=60

# Usuário Administrador Inicial
ADMIN_EMAIL=
ADMIN_PASSWORD=
